# GRIDTWIN Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://gridtwin:gridtwin_secret@localhost:5432/gridtwin
DATABASE_URL_SYNC=postgresql://gridtwin:gridtwin_secret@localhost:5432/gridtwin
POSTGRES_USER=gridtwin
POSTGRES_PASSWORD=gridtwin_secret
POSTGRES_DB=gridtwin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change-this-to-a-random-secret-key-in-production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_LOG_LEVEL=INFO

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=gridtwin
MQTT_PASSWORD=gridtwin_mqtt_secret
MQTT_CLIENT_ID=gridtwin-backend

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_TITLE=GRIDTWIN

# ESP32 (for firmware configuration)
ESP32_WIFI_SSID=your_wifi_ssid
ESP32_WIFI_PASSWORD=your_wifi_password
ESP32_MQTT_BROKER=192.168.1.100
ESP32_MQTT_PORT=1883
ESP32_DEVICE_ID=esp32-gridtwin-001
